# Supabase project (Project Settings > API). The anon key is public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. The public address of the app, used in WhatsApp share text and on image cards.
# When empty, the address the page is running on is used.
NEXT_PUBLIC_APP_URL=
